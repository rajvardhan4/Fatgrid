{
  "name": "fatgrid-clone",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others \"tsx watch server/local.ts\" \"next dev --hostname 127.0.0.1\"",
    "build": "next build && node scripts/build-worker.mjs",
    "start": "tsx server/local.ts",
    "db:generate": "drizzle-kit generate",
    "test": "tsx --test tests/*.test.ts",
    "admin:grant": "tsx scripts/grant-admin.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "esbuild": "$esbuild"
  }
}
