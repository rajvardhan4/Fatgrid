# Local server settings. Copy to .env.local. Never commit credentials.
APP_ORIGIN=http://localhost:3000
API_PORT=3001
DATABASE_PATH=data/fatgrid.sqlite
# Only this email is permitted to administer inventory and fulfillment.
ADMIN_EMAIL=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
PERPLEXITY_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ADVANCED_PRICE_ID=
# Optional independent-host scheduler authorization. Not needed by the local timer.
# On Vercel, setting it also enables the daily Vercel Cron in vercel.json.
CRON_SECRET=
# Transactional email (password reset links, backlink alerts) through Resend.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. FatGrid <no-reply@your-domain.com>
EMAIL_FROM=
# Google sign-in. Authorized redirect URI: <APP_ORIGIN>/api/auth/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# PRIVATE_SCHEDULER=1 is reserved for the verified owner-private Sites deployment.
# For Vercel, APP_ORIGIN should be https://fatgrid-ebon.vercel.app, not localhost.

# Cloud MySQL 8.0.16+ (Vercel backend). URL-encode password special characters.
MYSQL_URL=
MYSQL_SSL_CA=
# MYSQL_SSL=false is allowed only for local MySQL development.
